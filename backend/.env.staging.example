# Staging (Hostinger api-staging subdomain). Copy to .env on the staging host; never commit real values.
# Keep Remote MySQL disabled. Hostinger web hosting allows one database user.
APP_NAME=GCE
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Required only when seeding demo accounts.
SEED_USER_PASSWORD=

FRONTEND_URL=https://staging.example.com
SANCTUM_STATEFUL_DOMAINS=staging.example.com
SESSION_COOKIE=gce_session
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Phase 6: PayMongo sandbox (sk_test_...) and the webhook's signing secret (whsk_...).
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
