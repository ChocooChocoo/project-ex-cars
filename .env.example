# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: role-guarded server actions, seeding and e2e set-up.
SUPABASE_SERVICE_ROLE_KEY=
# Password of the seeded demo accounts (npm run seed:data, Playwright specs).
SEED_USER_PASSWORD=
DATABASE_URL=

# PayMongo payment link the buyer is sent to when they click Pay. Leave empty until GCE has one: Pay then
# answers "Online payment is not set up yet."
NEXT_PUBLIC_PAYMONGO_LINK=
