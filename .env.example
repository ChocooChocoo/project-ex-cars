# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: role-guarded server actions, seeding and e2e set-up.
SUPABASE_SERVICE_ROLE_KEY=
# Password of the seeded demo accounts (npm run seed:data, Playwright specs).
SEED_USER_PASSWORD=
DATABASE_URL=

# PayMongo (server only, never NEXT_PUBLIC_). Secret key (sk_test_… in test mode) for Checkout, and the
# secret of the dashboard webhook pointing at <site>/api/paymongo/webhook (event checkout_session.payment.paid).
# Without the secret key, Pay answers "Online payment is not set up yet."
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Public origin (e.g. https://global-exchange-car.vercel.app) used for PayMongo's return links and the
# sign-up verification link when a request carries no Origin header.
NEXT_PUBLIC_SITE_URL=

# Continue with Google, local Supabase only (supabase/config.toml). On the hosted project, enter the same
# client ID and secret in the dashboard: Authentication > Providers > Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# OR/CR and buyer ID auto-check (server only, never NEXT_PUBLIC_). Provider names must match an adapter in
# src/lib/verification/verify-document.ts ("ocrspace" for both, one free key from https://ocr.space/ocrapi). Left empty (the default) or failing, documents get "needs manual review"
# and staff verify them by hand as before. Staff Verify is always the final decision.
ORCR_VERIFY_PROVIDER=
ORCR_VERIFY_API_KEY=
ID_VERIFY_PROVIDER=
ID_VERIFY_API_KEY=
